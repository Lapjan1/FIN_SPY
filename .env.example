# ENV NAMES ONLY - never commit real values. See AGENTS.md.

# Database
DATABASE_URL=sqlite:///./data/fin_spy.db
# For prod: postgresql://user:pass@host:5432/fin_spy
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=anon_key_from_supabase
SUPABASE_JWT_SECRET=jwt_secret
STORAGE_BUCKET=fin-spy-vault

# Meta Models - worker only! Selection via MODEL keys (admin Settings UI saves
# `model` to the settings table; env wins when set). Provider is derived from
# the model id by resolve_model() in apps/worker/llm/client.py.
META_API_KEY=llama_api_key_from_meta_dashboard
MODEL=muse-spark-1.3
MODEL_EXTRACTION=muse-spark-1.3
MODEL_CHAT=muse-spark-1.3
IMAGE_BASE_URL=https://api.llama.com/compat/v1
IMAGE_API_KEY=llama_api_key_from_meta_dashboard
SAM_ENDPOINT_URL=http://sam-service:8000/segment
META_RATE_LIMIT_RPM=100
# Contributor tier is explicit-code-only for synthetic tests, NEVER via env:
# muse-spark-1.3-contributor (resolve_model refuses it fail-closed)

# Email - Resend free tier per homework Part 5.14 + clearmind SMTP pattern, worker only, no-reply mail for login
EMAIL_API_KEY=resend_api_key_re_...  # Resend or Postmark free tier, worker only, never browser
EMAIL_FROM=noreply@fin-spy.example
# Fallback SMTP like clearmind
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=smtp_pass_here
SMTP_FROM=noreply@fin-spy.example

# Local dev fallbacks
FREELLMAPI_API_KEY=freellmapi_key_from_env_user
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Payments - api only, test mode for hackathon demo
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_PLAN_CODES_JSON={"free":"PLN_xxx","individual":"PLN_yyy","sme":"PLN_zzz"}

# Observability
SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
EMAIL_API_KEY=re_...

# Trust
TSA_URLS=https://freetsa.org/tsr,https://timestamp.digicert.com
SIGNING_KEY_PEM_PATH=./certs/signing.pem
APP_BASE_URL=http://127.0.0.1:3000
ENVIRONMENT=development

# FNBP reference path - READ ONLY if you get stuck (25+ adaptors), never import code
FNBP_REFERENCE_PATH=C:\Users\dshan\Downloads\Projects\FNBP-App

# Evidence vault local path for MVP
VAULT_PATH=./data/vault
SAMPLE_DATA_PATH=./data/samples
