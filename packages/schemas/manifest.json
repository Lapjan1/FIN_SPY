{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Pack Manifest - Appendix C",
  "type": "object",
  "required": ["manifest_version","generated_at_utc","files","audit_chain"],
  "properties": {
    "manifest_version": {"type": "integer", "const": 1},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "tenant": {"type": "string"},
    "report_id": {"type": "string"},
    "software": {
      "type": "object",
      "properties": {
        "git_commit": {"type": "string"},
        "pipeline_version": {"type": "string"}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path","sha256","role"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "role": {"type": "string", "enum": ["original","derivative","extraction_raw","report","timestamp","audit"]},
          "uploaded_by": {"type": "string"},
          "uploaded_at_utc": {"type": "string", "format": "date-time"},
          "derived_from": {"type": "string"},
          "tsa_token": {"type": "string"}
        }
      }
    },
    "extraction_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "model_id": {"type": "string"},
          "prompt_sha256": {"type": "string"},
          "params": {"type": "object"},
          "raw_output": {"type": "string"},
          "raw_sha256": {"type": "string"}
        }
      }
    },
    "audit_chain": {
      "type": "object",
      "properties": {
        "from_id": {"type": "integer"},
        "to_id": {"type": "integer"},
        "head_hash": {"type": "string"},
        "anchor_tsr": {"type": "string"}
      }
    }
  }
}
